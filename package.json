{
  "name": "mxspub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production && pnpm run check:mobile",
